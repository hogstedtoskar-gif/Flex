{
  "name": "Time Tracker",
  "short_name": "Time Tracker",
  "description": "Track working hours, overtime, and flex balance.",
  "start_url": "/quick",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1115",
  "theme_color": "#4f8cff",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Clock in",
      "url": "/quick?action=clock-in",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Clock out",
      "url": "/quick?action=clock-out",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Toggle lunch",
      "url": "/quick?action=lunch-toggle",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    }
  ]
}
